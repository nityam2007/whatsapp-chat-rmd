{
  "name": "whatsapp-chat-rmd",
  "version": "0.8.0",
  "description": "Argus - AI-powered event extraction from WhatsApp messages",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:all": "./scripts/start-all.sh",
    "stop:all": "./scripts/stop-all.sh",
    "webapp": "tsx webapp/server.ts",
    "webapp:dev": "tsx watch webapp/server.ts",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate": "tsx src/database/migrate.ts",
    "docker:build": "docker build -f docker/Dockerfile -t whatsapp-rmd .",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "orchestrator:dev": "tsx watch src/orchestrator/index.ts",
    "e2e-test": "tsx scripts/e2e-test.ts",
    "e2e-quick": "tsx scripts/e2e-quick.ts"
  },
  "keywords": [
    "whatsapp",
    "reminder",
    "events",
    "ai",
    "llm",
    "evolution-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "ioredis": "^5.9.0",
    "nanoid": "^5.1.5",
    "openai": "^4.96.0",
    "tiktoken": "^1.0.21",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.3",
    "ws": "^8.18.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/cron": "^2.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.29",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^9.28.0",
    "msw": "^2.10.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
