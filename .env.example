# ===========================================
# WhatsApp Chat RMD - Environment Configuration
# ===========================================

# Environment
NODE_ENV=development
PORT=3000
WEBAPP_PORT=3002
TIMEZONE=Asia/Kolkata

# Orchestrator
ORCHESTRATOR_PORT=4000
ORCHESTRATOR_URL=http://localhost:4000

# Database
DATABASE_PATH=./data/db/events.db

# Vector Store
FAISS_INDEX_PATH=./data/vectors/index

# Redis (Required for multi-container)
REDIS_URL=redis://localhost:6379

# ===========================================
# Gemini Configuration (Primary - Recommended)
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ===========================================
# OpenAI Configuration (Fallback)
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# Evolution API (WhatsApp)
# ===========================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=rmd_evolution_api_key_12345
EVOLUTION_INSTANCE_NAME=whatsapp-rmd

# ===========================================
# Proactive Triggers (v0.8.0)
# ===========================================
# Enable intelligent proactive reminders
ENABLE_PROACTIVE_TRIGGERS=true
# Interval for checking proactive triggers (ms)
PROACTIVE_CHECK_INTERVAL=60000

# ===========================================
# Message Processing
# ===========================================
# Process your own sent messages (true/false)
PROCESS_OWN_MESSAGES=true
# Skip group messages (true/false)
SKIP_GROUP_MESSAGES=true

# ===========================================
# Pipeline Settings
# ===========================================
# Heuristic gate score threshold (default: 1)
HEURISTIC_THRESHOLD=1

# ===========================================
# Web Push (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
# ===========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug

# ===========================================
# User Container (Set by orchestrator)
# ===========================================
USER_ID=
CONTAINER_ID=
