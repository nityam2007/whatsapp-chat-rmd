    classDef storage fill:#0ea5e9,color:#fff
    classDef proactive fill:#8b5cf6,color:#fff
    classDef notify fill:#f97316,color:#fff
    classDef external fill:#10a37f,color:#fff
    classDef webapp fill:#ec4899,color:#fff

    class PHONE,BROWSER input
    class WACLOUD,BAILEYS,PG evolution
    class TRAVEL,SHOP,STREAM,BG,CONTENT,POPUP chrome
    class WH_RECV,DEDUP,CONTACT,GATE,EXTRACT,STORE pipeline
    class SQLITE,FAISS storage
    class TRIGGER,FAISS_Q,GEMINI_V proactive
    class API_CTX,API_LOC,API_HOT chrome
    class VAPID,WEB_PUSH,OVERLAY,ALERT notify
    class OPENAI,GEMINI,REDIS external
    class DASH,PUSH_MGR,PROXY webapp
