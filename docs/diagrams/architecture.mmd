---
title: Argus v1.0.0 - Simplified Vector-First Memory
---
flowchart TB
    %% ============================================
    %% COMPLETE ARCHITECTURE - Based on Actual Code
    %% ============================================

    %% === INPUT SOURCES ===
    subgraph Inputs["📥 INPUT SOURCES"]
        direction LR
        PHONE["📱 Phone<br/>WhatsApp App"]
        BROWSER["🌐 Browser<br/>Chrome"]
    end

    %% === WHATSAPP INTEGRATION ===
    subgraph Evolution["🔌 EVOLUTION API (Port 8080)"]
        direction TB
        WACLOUD["WhatsApp Cloud"]
        BAILEYS["Baileys Library<br/>WhatsApp Web Protocol"]
        PG[("PostgreSQL<br/>Message History")]
        
        WACLOUD <--> BAILEYS
        BAILEYS --> PG
    end

    %% === CHROME EXTENSION ===
    subgraph Chrome["🧩 CHROME EXTENSION (Manifest V3)"]
        direction TB
        
        subgraph Detectors["Site Detectors"]
            TRAVEL["✈️ Travel<br/>MakeMyTrip, Booking"]
            SHOP["🛒 Shopping<br/>Amazon, Flipkart"]
            STREAM["📺 Streaming<br/>Netflix, Prime"]
        end
        
        BG["Background Worker<br/>Service Worker"]
        CONTENT["Content Script<br/>Overlay Injection"]
        POPUP["Popup UI<br/>Status & Events"]
        
        TRAVEL --> BG
        SHOP --> BG
        STREAM --> BG
        BG --> CONTENT
    end

    %% === ARGUS CORE ===
    subgraph Argus["⚡ ARGUS SERVICE (Port 3000)"]
        direction TB
        
        %% Webhook Layer
        subgraph Webhook["📨 WEBHOOK LAYER"]
            WH_RECV["POST /webhook/evolution"]
            DEDUP["Deduplication<br/>5s window"]
            CONTACT["Extract Contact<br/>pushName → DB"]
        end
        
        %% Extraction Pipeline
        subgraph Pipeline["📥 EXTRACTION PIPELINE"]
            direction TB
            GATE["🚪 Heuristic Gate<br/>Keyword signals"]
            EXTRACT["🤖 Gemini 3<br/>Single-call Extract"]
            STORE["💾 Store + Embed"]
        end
        
        %% Storage
        subgraph Store["💾 STORAGE LAYER"]
            direction LR
            SQLITE[("SQLite<br/>Events, Messages<br/>Contacts, Logs")]
            FAISS[("FAISS Index<br/>Vector Embeddings")]
        end
        
        %% Proactive Engine
        subgraph ProactiveEngine["🔔 PROACTIVE ENGINE"]
            direction TB
            TRIGGER["Trigger Check<br/>ALL messages"]
            FAISS_Q["FAISS Search<br/>Top-K=100, similarity>0.65"]
            GEMINI_V["🤖 Gemini 3<br/>Context Validation"]
        end
        
        %% Extension API
        subgraph ExtAPI["🌐 EXTENSION API"]
            direction LR
            API_CTX["POST /api/extension/context"]
            API_LOC["GET /api/extension/by-location"]
            API_HOT["GET /api/extension/hot-events"]
        end
        
        %% Scheduler
        subgraph Scheduler["⏰ SCHEDULER"]
            CRON["Cron Jobs"]
            DUE["Check Due Events"]
        end
    end

    %% === WEBAPP ===
    subgraph Webapp["🖥️ WEBAPP (Port 3002)"]
        direction TB
        DASH["Dashboard<br/>Events, Messages, Logs"]
        PUSH_MGR["Push Manager<br/>VAPID Subscriptions"]
        PROXY["API Proxy<br/>→ Argus API"]
    end

    %% === NOTIFICATIONS ===
    subgraph Notify["🔔 NOTIFICATIONS"]
        direction LR
        VAPID["VAPID Keys"]
        WEB_PUSH["Web Push<br/>Service Worker"]
        OVERLAY["Overlay Card<br/>Accept | Snooze | Dismiss"]
        ALERT["Browser Alert"]
    end

    %% === EXTERNAL SERVICES ===
    subgraph External["☁️ EXTERNAL SERVICES"]
        direction LR
        OPENAI["OpenAI API<br/>Embeddings"]
        GEMINI["Gemini 3 Flash/Pro API"]
        REDIS[("Redis<br/>Session Cache")]
    end

    %% ============================================
    %% CONNECTIONS - WhatsApp Flow
    %% ============================================
    PHONE <--> WACLOUD
    BAILEYS -->|"webhook POST"| WH_RECV
    WH_RECV --> DEDUP
    DEDUP --> CONTACT
    CONTACT --> SQLITE
    
    %% Extraction Pipeline Flow
    DEDUP --> GATE
    GATE -->|"signal"| EXTRACT
    EXTRACT <-->|"extract"| GEMINI
    EXTRACT --> STORE
    STORE --> SQLITE
    STORE -->|"embed"| OPENAI
    OPENAI --> FAISS
    
    %% Proactive from WhatsApp
    DEDUP -->|"ALL msgs"| TRIGGER
    TRIGGER --> FAISS_Q
    FAISS_Q --> FAISS
    FAISS_Q --> GEMINI_V
    GEMINI_V <--> GEMINI
    
    %% ============================================
    %% CONNECTIONS - Chrome Extension Flow
    %% ============================================
    BROWSER --> TRAVEL
    BROWSER --> SHOP
    BROWSER --> STREAM
    
    BG -->|"context"| API_CTX
    BG -->|"location"| API_LOC
    POPUP -->|"events"| API_HOT
    
    API_CTX --> FAISS_Q
    API_LOC --> SQLITE
    API_HOT --> SQLITE
    
    %% ============================================
    %% CONNECTIONS - Notifications
    %% ============================================
    GEMINI_V -->|"match"| WEB_PUSH
    GEMINI_V -->|"match"| OVERLAY
    OVERLAY --> CONTENT
    
    SCHEDULER --> DUE
    DUE --> SQLITE
    DUE --> WEB_PUSH
    
    WEB_PUSH --> VAPID
    VAPID --> ALERT
    
    %% Webapp connections
    DASH --> PROXY
    PROXY --> Argus
    PUSH_MGR --> VAPID
    
    %% Redis
    Evolution <--> REDIS
    Argus <--> REDIS

