%%{init: {'theme': 'base'}}%%

flowchart TB
    %% ============================================
    %% SYSTEM OVERVIEW - High Level Architecture
    %% ============================================

    subgraph PHONE["User Phone"]
        WA["WhatsApp App"]
    end

    subgraph CLOUD["WhatsApp Cloud"]
        SERVERS["WhatsApp Servers"]
    end

    subgraph SERVER["Your Server"]
        
        subgraph EVO_CONTAINER["Evolution API Container"]
            EVO["Evolution API :8080"]
            BAILEYS["Baileys Library"]
        end

        subgraph ARGUS_CONTAINER["Argus Service Container"]
            WEBHOOK["Webhook Handler"]
            PIPELINE["AI Pipeline"]
            SIMPLE["Simple Pipeline"]
            DB[("SQLite DB")]
            VECTOR[("FAISS Index")]
            SCHEDULER["Scheduler"]
        end

        subgraph PUSH_CONTAINER["Push Webapp Container"]
            PUSH_API["Push API :3002"]
            SW["Service Worker"]
        end

        subgraph MONITOR["Monitoring Stack"]
            GRAFANA["Grafana :3001"]
            LOKI["Loki :3100"]
        end

        REDIS[("Redis")]
    end

    subgraph EXTERNAL["External Services"]
        GEMINI["Gemini 3 Flash/Pro API"]
        OPENAI["OpenAI Embeddings"]
    end

    subgraph BROWSER["User Browser"]
        NOTIF["Push Notifications"]
    end

    %% Connections
    WA <--> SERVERS
    SERVERS <--> BAILEYS
    BAILEYS --> EVO
    EVO -->|"Webhook POST"| WEBHOOK
    WEBHOOK --> SIMPLE
    SIMPLE --> GEMINI
    SIMPLE --> OPENAI
    SIMPLE --> DB
    SIMPLE --> VECTOR
    SIMPLE --> SCHEDULER
    SCHEDULER --> PUSH_API
    PUSH_API --> SW
    SW --> NOTIF
    
    EVO <--> REDIS
    SIMPLE <--> REDIS
    SIMPLE --> LOKI
    LOKI --> GRAFANA

    %% Styling
    style WA fill:#25D366,color:#fff
    style EVO fill:#6366f1,color:#fff
    style SIMPLE fill:#8b5cf6,color:#fff
    style GEMINI fill:#4285f4,color:#fff
    style OPENAI fill:#10a37f,color:#fff
    style NOTIF fill:#f59e0b,color:#fff
    style REDIS fill:#dc2626,color:#fff
    style GRAFANA fill:#f97316,color:#fff
