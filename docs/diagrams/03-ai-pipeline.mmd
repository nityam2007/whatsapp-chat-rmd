flowchart TD
    subgraph Input
        MSG[Incoming WhatsApp Message]
    end

    subgraph Stage0[Stage 0 - Proactive Trigger]
        PT1[Load Pending Events]
        PT2[FAISS Search Top-K]
        PT3[Gemini Context Match]
        PT4{Match Found?}
        PT5[Send Reminder]
    end

    subgraph Stage1[Stage 1 - Heuristic Gate]
        H1{Contains keywords?}
        H2[Calculate Signal Score]
    end

    subgraph Stage2[Stage 2 - Gemini Extract]
        E1[Gemini 3 Flash/Pro]
        E2[Extract Structured Data]
    end

    subgraph Stage3[Stage 3 - Store + Embed]
        R1[Store New Event]
        R2[Generate Embedding]
        R3[Store in FAISS]
    end

    subgraph Output
        OUT1[(SQLite DB)]
        OUT2[(Vector Store)]
        OUT3[Scheduler]
        OUT4[Push Notification]
    end

    DROP[Drop Message]

    MSG --> PT1
    PT1 --> PT2
    PT2 --> PT3
    PT3 --> PT4
    PT4 -->|Yes| PT5
    PT4 -->|No| H1
    PT5 --> H1
    H1 -->|No Signal| DROP
    H1 -->|Has Signal| H2
    H2 --> E1
    E1 --> E2
    E2 --> R1
    R1 --> R2
    R2 --> R3
    R1 --> OUT1
    R3 --> OUT2
    OUT3 --> OUT4

    style MSG fill:#25D366,color:#fff
    style PT2 fill:#4285f4,color:#fff
    style PT4 fill:#8b5cf6,color:#fff
    style E1 fill:#4285f4,color:#fff
    style OUT4 fill:#f59e0b,color:#fff
    style DROP fill:#ef4444,color:#fff
