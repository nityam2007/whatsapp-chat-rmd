            VEC[(Vectors)]
        end
        
        subgraph Learning["Auto-Learning"]
            PL[Pattern Learner]
            LP[(Learned Patterns)]
        end
        
        SCH[Scheduler]
        PUSH[Push Service<br/>:3002]
    end

    subgraph Browser["Browser"]
        SW[Service Worker]
        NOT[Notification]
    end

    subgraph AI["AI Services"]
