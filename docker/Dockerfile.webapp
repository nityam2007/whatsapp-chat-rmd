# WhatsApp Chat RMD - Webapp Dockerfile
# Dashboard and Push Notification Service

# ===========================================
# Stage 1: Builder
# ===========================================
FROM node:22-alpine AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++ && \
    ln -sf python3 /usr/bin/python

# Copy package files first (better layer caching)
COPY package*.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci --include=dev

# Copy source files needed for webapp
COPY tsconfig.json ./
COPY webapp ./webapp
COPY src/shared ./src/shared
COPY src/types ./src/types
COPY src/config ./src/config

# Build webapp TypeScript
RUN npx tsc webapp/server.ts \
    --outDir dist/webapp \
    --esModuleInterop \
    --moduleResolution node \
    --target ES2022 \
    --module NodeNext \
    --skipLibCheck

# Prune dev dependencies
RUN npm prune --omit=dev

# ===========================================
# Stage 2: Production
# ===========================================
FROM node:22-alpine AS production

# Labels for image metadata
LABEL org.opencontainers.image.title="WhatsApp Chat RMD Webapp"
LABEL org.opencontainers.image.description="Dashboard and Push Notification Service"
LABEL org.opencontainers.image.version="0.5.0"

# Set working directory
WORKDIR /app

# Install runtime dependencies only
RUN apk add --no-cache \
    wget \
    dumb-init \
    && rm -rf /var/cache/apk/*

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

# Copy package files
COPY --from=builder /app/package*.json ./

# Copy node_modules from builder (already pruned)
COPY --from=builder /app/node_modules ./node_modules

# Copy built files
COPY --from=builder /app/dist/webapp ./dist/webapp

# Copy webapp static files
COPY webapp/public ./webapp/public

# Create data directories with proper permissions
RUN mkdir -p data logs && \
    chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Set environment
ENV NODE_ENV=production
ENV WEBAPP_PORT=3002

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3002/health || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Run webapp service
CMD ["node", "dist/webapp/server.js"]
