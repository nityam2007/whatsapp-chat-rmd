# Development Dockerfile with hot reload
FROM node:20-alpine

WORKDIR /app

# Install dependencies for native modules
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install all dependencies
RUN npm ci

# Copy TypeScript config
COPY tsconfig.json ./

# Expose port
EXPOSE 3000

# Run with tsx watch
CMD ["npm", "run", "dev"]
